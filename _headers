# Cloudflare Pages response headers.
# Scripts and stylesheets use the Pages default revalidation policy because
# their paths are not fingerprinted. The root recovery worker is also revalidated.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/offline-resources-worker.js
  Cache-Control: no-cache

/app-version.json
  Cache-Control: no-store
