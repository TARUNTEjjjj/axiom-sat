{
  "name": "axiom-sat",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source SAT Math practice with generated questions, timed sessions, worked review, and local progress.",
  "type": "module",
  "scripts": {
    "test": "node tests/run.js",
    "audit:questions": "node scripts/audit-questions.mjs",
    "serve": "python3 -m http.server 8787",
    "build": "node tests/run.js && node scripts/build.mjs",
    "test:resources:ui": "node --test scripts/resource-explorer.test.mjs",
    "resources:refresh": "node scripts/resources/resource-server.mjs refresh --config resources/sources.json --output resources/catalog.json",
    "resources:serve": "node scripts/resources/resource-server.mjs serve --config resources/sources.json --snapshot resources/catalog.json",
    "test:resources": "node --test scripts/resources/resource-catalog.test.mjs && node scripts/resources/check-catalog.mjs"
  },
  "license": "MIT"
}
